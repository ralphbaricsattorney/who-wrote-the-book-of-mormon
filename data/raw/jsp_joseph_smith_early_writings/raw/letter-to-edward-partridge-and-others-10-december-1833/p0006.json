": "", "longcitation": null}, {"id": "8056501357064781160", "text": "<html><head></head><body><p class=\"bottom_0\">In March 1831, JS dictated a <a href=\"/paper-summary/revelation-circa-7-march-1831-dc-45\" class=\"referenceInPop\" pop=\"/ajax/papers/tooltip/revelation-circa-7-march-1831-dc-45\" poptitle=\"Revelation, circa 7 March 1831 [D&amp;C\n45]\">revelation</a> that stated that <a href=\"/topic/zion\" class=\"referenceInPop\">Zion</a> would be “a land of peace a City of refuge a place of safety for the saints of The most high God” and that even unbelievers, for survival in the turbulent days before Christ’s second coming, “must needs flee unto Zion for safety.” (<a href=\"/paper-summary/revelation-circa-7-march-1831-dc-45\" class=\"referenceInPop\" pop=\"/ajax/papers/tooltip/revelation-circa-7-march-1831-dc-45\" poptitle=\"Revelation, circa 7 March 1831 [D&amp;C\n45]\">Revelation, ca. 7 Mar. 1831</a> [D&amp;C 45:66, 68].)</p></body></html>", "number": 40, "type": "number", "toenote": "", "longcitation": null}, {"id": "1623151669589331837", "text": "<html><head></head><body><p class=\"bottom_0\">See <a href=\"/paper-summary/revelation-9-february-1831-dc-421-72\" class=\"referenceInPop\" pop=\"/ajax/papers/tooltip/revelation-9-february-1831-dc-421-72\" poptitle=\"Revelation, 9\nFebruary 1831 [D&amp;C 42:1–72]\">Revelation, 9</a> and <a href=\"/paper-summary/revelation-23-february-1831-dc-4274-93\" class=\"referenceInPop\" pop=\"/ajax/papers/tooltip/revelation-23-february-1831-dc-4274-93\" poptitle=\"Revelation, 23 February 1831 [D&amp;C\n42:74–93]\">23 Feb. 1831</a> [D&amp;C 42].</p></body></html>", "number": 41, "type": "number", "toenote": "", "longcitation": null}, {"id": "4885900621048519550", "text": "<html><head></head><body><p class=\"bottom_0\">See Jeremiah 50:5.</p></body></html>", "number": 42, "type": "number", "toenote": "", "longcitation": null}, {"id": "15484613336650056652", "text": "<html><head></head><body><p class=\"bottom_0\">See Malachi 3:16; and <a href=\"/paper-summary/letter-to-william-w-phelps-27-november-1832\" class=\"referenceInPop\" pop=\"/ajax/papers/tooltip/letter-to-william-w-phelps-27-november-1832\" poptitle=\"Letter to William W. Phelps, 27\nNovember 1832\">Letter to William W. Phelps, 27 Nov. 1832</a> [D&amp;C 85:9].</p></body></html>", "number": 43, "type": "number", "toenote": "", "longcitation": null}, {"id": "5369878371905200471", "text": "<html><head></head><body><p class=\"bottom_0\">See Job 38:41.</p></body></html>", "number": 44, "type": "number", "toenote": "", "longcitation": null}, {"id": "7645283631058925441", "text": "<html><head></head><body><p class=\"bottom_0\">See Revelation 21:27.</p></body></html>", "number": 45, "type": "number", "toenote": "", "longcitation": null}], "meta": {"/paper-summary-PageTitle": "Letter to Edward Partridge and Others, 10 December 1833, Page 75", "/paper-summary-MetaTitle": "Letter to Edward Partridge and Others, 10 December 1833, Page 75", "/paper-summary-MetaDescription": "other place should be appointed like unto this35See Revelation, ca. 7 Mar. 1831 [D&C 45:65–66]; Reve...", "/paper-summary-MetaUrl": "/paper-summary/letter-to-edward-partridge-and-others-10-december-1833/6", "/paper-summary-MetaImage": "/bc-jsp/content/jsp/images/7633/7633_ms155_2_01_lb1_075_thumb.jpg"}, "scribes": [{"id": "per63", "name": "Frederick G. Williams"}], "printVolumeLocation": "<a href=\"http://www.josephsmithpapers.org/articles/documents-volume-3-february-1833-march-1834\" class=\"externalLink\" xmlns:srchdoc=\"https://ldsc.xmlref.com/local/ldschurch/searchDocuments\" xmlns:lds=\"https://ldsc.xmlref.com/local/ldschurch\"><span class=\"title\">JSP,</span> D3:375–381</a>"}, "legal": {}, "disableVerticalScroll": true, "documentURI": "/published/jsp/searchable/papers/30495/30495-0006.xml", "searchOptions": [{"name": "| This Document", "value": "document"}, {"name": "| Full Site", "value": "site"}]}