image": "/11909/11909_ms16800_1_14_010_thumb.jpg", "page": "14", "label": "10", "href": "/paper-summary/ordinance-14-november-1842/14"}, {"image": "/11909/11909_ms16800_1_14_011_thumb.jpg", "page": "15", "label": "11", "href": "/paper-summary/ordinance-14-november-1842/15"}, {"image": "/11909/11909_ms16800_1_14_012_thumb.jpg", "page": "16", "label": "12", "href": "/paper-summary/ordinance-14-november-1842/16"}, {"image": "/11909/11909_ms16800_1_14_013_thumb.jpg", "page": "17", "label": "13", "href": "/paper-summary/ordinance-14-november-1842/17"}, {"image": "/11909/11909_ms16800_1_14_014_thumb.jpg", "page": "18", "label": "14", "href": "/paper-summary/ordinance-14-november-1842/18"}, {"image": "/11909/11909_ms16800_1_14_015_thumb.jpg", "page": "19", "label": "15", "href": "/paper-summary/ordinance-14-november-1842/19"}, {"image": "/11909/11909_ms16800_1_14_016_thumb.jpg", "page": "20", "label": "16", "href": "/paper-summary/ordinance-14-november-1842/20"}, {"image": "/11909/11909_ms16800_1_14_017_thumb.jpg", "page": "21", "label": "17", "href": "/paper-summary/ordinance-14-november-1842/21"}, {"image": "/11909/11909_ms16800_1_14_018_thumb.jpg", "page": "22", "label": "18", "href": "/paper-summary/ordinance-14-november-1842/22"}, {"image": "/11909/11909_ms16800_1_14_019_thumb.jpg", "page": "23", "label": "[19]", "href": "/paper-summary/ordinance-14-november-1842/23"}, {"image": "/11909/11909_ms16800_1_14_020_thumb.jpg", "page": "24", "label": "[20]", "href": "/paper-summary/ordinance-14-november-1842/24"}], "tableOfContents": [], "summary": {"uri": "ordinance-14-november-1842", "series": "JSPPA", "urlTitleValue": "JSPPA6", "documentSeriesIdCompiled": "jsppa6-sub-nccr-sub02-421114", "documentSeriesUri": "/the-papers/administrative-records/jsppa6/jsppa6-sub-nccr/jsppa6-sub-nccr-sub02/jsppa6-sub-nccr-sub02-421114", "documentSeriesTitle": "<p>\r\n\tMeeting, 14 November 1842</p>", "editorialPageNumber": "0", "isPageNumberPresent": false, "searchUrl": "/published/jsp/searchable/papers/54016763/54016763-0006.xml", "clearText": "<html><head></head><body><div class=\"indent wasptag\">This comes in as the latter part of Sec. 1.— on <a href=\"/paper-summary/ordinance-14-november-1842/5\" class=\"externalLink\">page 3</a>.—</div> <div class=\"indent wasptag\">* Provided nevertheless, that in case any Person or persons may at any time hereafter be taken and lodged in the City , or County jail , under any Writ or process, as provided by the <a href=\"/paper-summary/act-to-incorporate-the-city-of-nauvoo-16-december-1840\" class=\"reference\" pop=\"/ajax/papers/tooltip/act-to-incorporate-the-city-of-nauvoo-16-december-1840\" poptitle=\"Act to Incorporate the City of Nauvoo, 16 December 1840\">City Charter</a> of the City of <aside class=\"popup-wrapper\" id=\"2918253433713284880\"><a href=\"#2918253433713284880\" class=\"reference staticPopup\" ro=\"plc12\" place=\"plc12\" title=\"Nauvoo, Illinois\">Nauvoo</a><div class=\"popup-content\"><div class=\"note-data\" isnote=\"Y\" isnonsearchable=\"Y\"><input type=\"hidden\" value=\"Nauvoo, Illinois\"><p>Principal gathering place for Saints following expulsion from Missouri. Beginning in 1839, Church of Jesus Christ of Latter-day Saints purchased lands in earlier settlement of Commerce and planned settlement of Commerce City, as well as surrounding areas....</p><a class=\"more\" href=\"/place/nauvoo-illinois\">More Info</a></div></div></aside>, and shall require a Writ of <aside class=\"popup-wrapper\" id=\"244478512288388138\"><a href=\"#244478512288388138\" class=\"reference staticPopup\" ro=\"x41899\" topic=\"x41899\" title=\"Habeas corpus\">Habeas Corpus</a><div class=\"popup-content\"><div class=\"note-data\" isnote=\"Y\" isnonsearchable=\"Y\"><input type=\"hidden\" value=\"Habeas corpus\"><p>“Have the body”; a written order from a court of competent jurisdiction commanding anyone having a person in custody to produce such person at a certain time and place and to state the reasons why he or she is being held in custody. The court will determine...</p><a class=\"more\" href=\"/topic/habeas-corpus\">View Glossary</a></div></div></aside> to issue, to bring him her or them before the Municipal Court of said <aside class=\"popup-wrapper\" id=\"6996833135071453111\"><a href=\"#6996833135071453111\" class=\"reference staticPopup\" ro=\"plc12\" place=\"plc12\" title=\"Nauvoo, Illinois\">City</a><div class=\"popup-content\"><div class=\"note-data\" isnote=\"Y\" isnonsearchable=\"Y\"><input type=\"hidden\" value=\"Nauvoo, Illinois\"><p>Principal gathering place for Saints following expulsion from Missouri. Beginning in 1839, Church of Jesus Christ of Latter-day Saints purchased lands in earlier settlement of Commerce and planned settlement of Commerce City, as well as surrounding areas....</p><a class=\"more\" href=\"/place/nauvoo-illinois\">More Info</a></div></div></aside>, said Writ shall issue to bring him her or them before said Court, and be directed to the City Marshal to be served upon the Person or Persons in whose Custody such Prisoner or Prisoners may then be detained. </div></body></html>", "expandedText": "<html><head></head><body><div class=\"indent wasptag\">&lt;&lt;​This comes in as the latter part of Sec. 1.— on <a href=\"/paper-summary/ordinance-14-november-1842/5\" class=\"externalLink\">page 3</a>.—​&gt;<aside class=\"popup-wrapper\" id=\"6550739426477639521\"><a href=\"#6550739426477639521\" class=\"editorial-note-static staticPopup\" title=\"Note\" name=\"trans13\"><span id=\"documenttrans13\">13</span></a><div class=\"popup-content\"><div class=\"note-data editorial-footnote\" isnote=\"Y\"><p class=\"bottom_0\">TEXT: The text on this inserted page should be included on <a href=\"/paper-summary/ordinance-14-november-1842/5\" class=\"externalLink\">page 3</a>, where there is a corresponding quartered circle represented by an asterisk.</p><hr></div></div></aside></div> <div class=\"indent wasptag\">*<aside class=\"popup-wrapper\" id=\"8456486465958998373\"><a href=\"#8456486465958998373\" class=\"editorial-note-static staticPopup\" title=\"Note\" name=\"trans14\"><span id=\"documenttrans14\">14</span></a><div class=\"popup-content\"><div class=\"note-data editorial-footnote\" isnote=\"Y\"><p class=\"bottom_0\">TEXT: A quartered circle was drawn in the margin.</p><hr></div></div></aside> Provided nevertheless, that in case any Person or <span class=\"line-break\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>person&lt;​s​&gt; may at any time hereafter be taken and <span class=\"line-break\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>lodged in the City <span class=\"deleted\">jail</span>, or County jail <span class=\"deleted\">of <aside class=\"popup-wrapper\" id=\"519819437147868807\"><a href=\"#519819437147868807\" class=\"reference staticPopup\" ro=\"plc25\" place=\"plc25\" title=\"Hancock County, Illinois\">Hancock <span class=\"line-break\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>County</a><div class=\"popup-content\"><div class=\"note-data\" isnote=\"Y\" isnonsearchable=\"Y\"><input type=\"hidden\" value=\"Hancock County, Illinois\"><p>Formed from Pike Co., 1825. Described in 1837 as predominantly prairie and “deficient in timber.” Early settlers came mainly from mid-Atlantic and southern states. Population in 1835 about 3,200; in 1840 about 9,900; and in 1844 at least 15,000. Carthage ...</p><a class=\"more\" href=\"/place/hancock-county-illinois\">More Info</a></div></div></aside></span>, under any Writ or process, as provided by the <span class=\"line-break\" xmlns=\"http://www.w3.org/1999/xhtml\"></span><a href=\"/paper-summary/act-to-incorporate-the-city-of-nauvoo-16-december-1840\" class=\"reference\" pop=\"/ajax/papers/tooltip/act-to-incorporate-the-city-of-nauvoo-16-december-1840\" poptitle=\"Act to Incorporate the City of Nauvoo, 16 December 1840\">City Charter</a> of the City of <aside class=\"popup-wrapper\" id=\"12147834365540356764\"><a href=\"#12147834365540356764\" class=\"reference staticPopup\" ro=\"plc12\" place=\"plc12\" title=\"Nauvoo, Illinois\">Nauvoo</a><div class=\"popup-content\"><div class=\"note-data\" isnote=\"Y\" isnonsearchable=\"Y\"><input type=\"hidden\" value=\"Nauvoo, Illinois\"><p>Principal gathering place for Saints following expulsion from Missouri. Beginning in 1839, Church of Jesus Christ of Latter-day Saints purchased lands in earlier settlement of Commerce and planned settlement of Commerce City, as well as surrounding areas....</p><a class=\"more\" href=\"/place/nauvoo-illinois\">More Info</a></div></div></aside>, and shall require a <span class=\"line-break\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>Writ of <aside class=\"popup-wrapper\" id=\"15658726994491133667\"><a href=\"#15658726994491133667\" class=\"reference staticPopup\" ro=\"x41899\" topic=\"x41899\" title=\"Habeas corpus\">Habeas Corpus</a><div class=\"popup-content\"><div class=\"note-data\" isnote=\"Y\" isnonsearchable=\"Y\"><input type=\"hidden\" value=\"Habeas corpus\"><p>“Have the body”; a written order from a court of competent jurisdiction commanding anyone having a person in custody to produce such person at a certain time and place and to state the reasons why he or she is being held in custody. The court will determine...</p><a class=\"more\" href=\"/topic/habeas-corpus\">View Glossary</a></div></div></aside> to issue, to bring him &lt;​<span class=\"deleted\">or</span> her​&gt; &lt;​or them​&gt; before the <span class=\"line-break\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>Municipal Court of said <aside class=\"popup-wrapper\" id=\"304928636682234431\"><a href=\"#304928636682234431\" class=\"reference staticPopup\" ro=\"plc12\" place=\"plc12\" title=\"Nauvoo, Illinois\">City</a><div class=\"popup-content\"><div class=\"note-data\" isnote=\"Y\" isnonsearchable=\"Y\"><input type=\"hidden\" value=\"Nauvoo, Illinois\"><p>Principal gathering place for Saints following expulsion from Missouri. Beginning in 1839, Church of Jesus Christ of Latter-day Saints purchased lands in earlier settlement of Commerce and planned settlement of Commerce City, as well as surrounding areas....</p><a class=\"more\" href=\"/place/nauvoo-illinois\">More Info</a></div></div></aside>, said Writ shall issue <span class=\"line-break\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>to bring him &lt;​&lt;​her​&gt; or <span class=\"deleted\">her</span> &lt;​them​&gt;​&gt; before said Court, and be directed to <span class=\"line-break\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>&lt;​the City Marshal to be served upon​&gt; the Person or Persons in whose Custody such Prisoner <span class=\"line-break\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>or Prisoners may then be detained. </div></body></html>", "calendarsOfDocuments": [], "versions": [{"versionTitle": "Ordinance, 14 November 1842", "versionLink": "/paper-summary/ordinance-14-november-1842/1", "versionFeatured": ""}, {"versionTitle": "Nauvoo City Council Minute Book, 1841–1845", "versionLink": "/paper-summary/nauvoo-city-council-minute-book-1841-1845/125", "versionFeatured": ""}, {"versionTitle": "Ordinance, 14 November 1842, as Published in the <em xmlns:tei=\"http://www.tei-c.org/ns/1.0\" xmlns:lds=\"https://ldsc.xmlref.com/local/ldschurch\">Wasp</em>", "versionLink": "/paper-summary/ordinance-14-november-1842-as-published-in-the-wasp/1", "versionFeatured": ""}, {"versionTitle": "History, 1838–1856, volume D-1 [1 August 1842–1 July 1843]", "versionLink": "/paper-summary/history-1838-1856-volume-d-1-1-august-1842-1-july-1843/58", "versionFeatured": ""}, {"versionTitle": "“History of Joseph Smith”", "versionLink": "/paper-summary/history-of-joseph-smith/451", "versionFeatured": ""}], "images": {"smallImageUrl": "/11909/11909_ms16800_1_14_003-01_thumb.jpg", "mediumImageUrl": "/11909/11909_ms16800_1_14_003-01_med.jpg", "largeImageUrl": "/11909/11909_ms16800_1_14_003-01.jpg", "downloadImageUrl": "/11909/11909_ms16800_1_14_003-01_download.jpg"}, "imageCredit": "", "fa