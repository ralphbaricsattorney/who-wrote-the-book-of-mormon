"image": "/11909/11909_ms16800_1_14_010_thumb.jpg", "page": "14", "label": "10", "href": "/paper-summary/ordinance-14-november-1842/14"}, {"image": "/11909/11909_ms16800_1_14_011_thumb.jpg", "page": "15", "label": "11", "href": "/paper-summary/ordinance-14-november-1842/15"}, {"image": "/11909/11909_ms16800_1_14_012_thumb.jpg", "page": "16", "label": "12", "href": "/paper-summary/ordinance-14-november-1842/16"}, {"image": "/11909/11909_ms16800_1_14_013_thumb.jpg", "page": "17", "label": "13", "href": "/paper-summary/ordinance-14-november-1842/17"}, {"image": "/11909/11909_ms16800_1_14_014_thumb.jpg", "page": "18", "label": "14", "href": "/paper-summary/ordinance-14-november-1842/18"}, {"image": "/11909/11909_ms16800_1_14_015_thumb.jpg", "page": "19", "label": "15", "href": "/paper-summary/ordinance-14-november-1842/19"}, {"image": "/11909/11909_ms16800_1_14_016_thumb.jpg", "page": "20", "label": "16", "href": "/paper-summary/ordinance-14-november-1842/20"}, {"image": "/11909/11909_ms16800_1_14_017_thumb.jpg", "page": "21", "label": "17", "href": "/paper-summary/ordinance-14-november-1842/21"}, {"image": "/11909/11909_ms16800_1_14_018_thumb.jpg", "page": "22", "label": "18", "href": "/paper-summary/ordinance-14-november-1842/22"}, {"image": "/11909/11909_ms16800_1_14_019_thumb.jpg", "page": "23", "label": "[19]", "href": "/paper-summary/ordinance-14-november-1842/23"}, {"image": "/11909/11909_ms16800_1_14_020_thumb.jpg", "page": "24", "label": "[20]", "href": "/paper-summary/ordinance-14-november-1842/24"}], "tableOfContents": [], "summary": {"uri": "ordinance-14-november-1842", "series": "JSPPA", "urlTitleValue": "JSPPA6", "documentSeriesIdCompiled": "jsppa6-sub-nccr-sub02-421114", "documentSeriesUri": "/the-papers/administrative-records/jsppa6/jsppa6-sub-nccr/jsppa6-sub-nccr-sub02/jsppa6-sub-nccr-sub02-421114", "documentSeriesTitle": "<p>\r\n\tMeeting, 14 November 1842</p>", "editorialPageNumber": "10", "isPageNumberPresent": true, "searchUrl": "/published/jsp/searchable/papers/54016763/54016763-0014.xml", "clearText": "<html><head></head><body><div class=\"indent continuation wasptag\"> Sec. 5. Where any Prisoner, or Prisoners brought up on a <aside class=\"popup-wrapper\" id=\"4917286222337496319\"><a href=\"#4917286222337496319\" class=\"reference staticPopup\" ro=\"x41899\" topic=\"x41899\" title=\"Habeas corpus\">Habeus Corpus</a><div class=\"popup-content\"><div class=\"note-data\" isnote=\"Y\" isnonsearchable=\"Y\"><input type=\"hidden\" value=\"Habeas corpus\"><p>“Have the body”; a written order from a court of competent jurisdiction commanding anyone having a person in custody to produce such person at a certain time and place and to state the reasons why he or she is being held in custody. The court will determine...</p><a class=\"more\" href=\"/topic/habeas-corpus\">View Glossary</a></div></div></aside>, shall be remanded to Prison, it shall be the duty of the Municipal Court remanding him, her or them, to make out and deliver to the Sheriff, or other Person, or Persons to whose custody he she or they shall be remanded, an Order in Writing, stating the Cause or Causes of remanding him her or them. If such Prisoner or Prisoners shall obtain a second Writ of Habeas Corpus, it shall be the duty of such Sheriff or other Person or Persons upon whom the same shall be served , to return therewith the Order aforesaid; and if it shall appear that the said Prisoner or Prisoners were remanded for an offence adjudged not bailable, it shall be taken and received as conclusive, and the Prisoner or Prisoners shall be remanded without further proceedings. [<span class=\"italic note-data editorial-comment\" isnote=\"Y\">1/4 page blank</span>] [p. 10]</div></body></html>", "expandedText": "<html><head></head><body><div class=\"indent continuation wasptag\"> Sec. 5. Where any Prisoner, &lt;​or Prisoners​&gt; brought up on a <aside class=\"popup-wrapper\" id=\"980623268607645258\"><a href=\"#980623268607645258\" class=\"reference staticPopup\" ro=\"x41899\" topic=\"x41899\" title=\"Habeas corpus\">Habeus Corpus</a><div class=\"popup-content\"><div class=\"note-data\" isnote=\"Y\" isnonsearchable=\"Y\"><input type=\"hidden\" value=\"Habeas corpus\"><p>“Have the body”; a written order from a court of competent jurisdiction commanding anyone having a person in custody to produce such person at a certain time and place and to state the reasons why he or she is being held in custody. The court will determine...</p><a class=\"more\" href=\"/topic/habeas-corpus\">View Glossary</a></div></div></aside>, <span class=\"line-break\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>shall be remanded to Prison, it shall be the duty <span class=\"line-break\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>of the &lt;​Municipal​&gt; Court remanding him, &lt;​her or them,​&gt; to make out and deliver to <span class=\"line-break\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>the Sheriff, or other Person, &lt;​or Persons​&gt; to whose custody he &lt;​&lt;​she​&gt; or <span class=\"deleted\">she</span> &lt;​they​&gt;​&gt; shall be <span class=\"line-break\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>remanded, an Order in Writing, stating the Cause or Causes <span class=\"line-break\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>of remanding him &lt;​<span class=\"deleted\">or her</span> &lt;​her or them​&gt;​&gt;. If such Prisoner &lt;​or Prisoners​&gt; shall obtain a <span class=\"line-break\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>second Writ of Habeas Corpus, it shall be the duty of <span class=\"line-break\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>such Sheriff or other Person &lt;​or Persons upon​&gt; <span class=\"deleted\">to</span> whom the same shall be <span class=\"line-break\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>&lt;​served​&gt; <span class=\"deleted\">directed</span>, to return therewith the Order aforesaid; and if <span class=\"line-break\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>it shall appear that the said Prisoner &lt;​or Prisoners were​&gt; <span class=\"deleted\">was</span> remanded <span class=\"line-break\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>for an offence adjudged not bailable, it shall be taken <span class=\"line-break\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>and received as conclusive, and the Prisoner &lt;​or Prisoners​&gt; shall be <span class=\"line-break\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>remanded without further proceedings. [<span class=\"italic note-data editorial-comment\" isnote=\"Y\">1/4 page blank</span>] [p. 10]</div></body></html>", "calendarsOfDocuments": [], "versions": [{"versionTitle": "Ordinance, 14 November 1842", "versionLink": "/paper-summary/ordinance-14-november-1842/1", "versionFeatured": ""}, {"versionTitle": "Nauvoo City Council Minute Book, 1841–1845", "versionLink": "/paper-summary/nauvoo-city-council-minute-book-1841-1845/125", "versionFeatured": ""}, {"versionTitle": "Ordinance, 14 November 1842, as Published in the <em xmlns:tei=\"http://www.tei-c.org/ns/1.0\" xmlns:lds=\"https://ldsc.xmlref.com/local/ldschurch\">Wasp</em>", "versionLink": "/paper-summary/ordinance-14-november-1842-as-published-in-the-wasp/1", "versionFeatured": ""}, {"versionTitle": "History, 1838–1856, volume D-1 [1 August 1842–1 July 1843]", "versionLink": "/paper-summary/history-1838-1856-volume-d-1-1-august-1842-1-july-1843/58", "versionFeatured": ""}, {"versionTitle": "“History of Joseph Smith”", "versionLink": "/paper-summary/history-of-joseph-smith/451", "versionFeatured": ""}], "images": {"smallImageUrl": "/11909/11909_ms16800_1_14_010_thumb.jpg", "mediumImageUrl": "/11909/11909_ms16800_1_14_010_med.jpg", "largeImageUrl": "/11909/11909_ms16800_1_14_010.jpg", "downloadImageUrl": "/11909/11909_ms16800_1_14_010_download.jpg"}, "imageCredit": "", "facsimile": "", "dzUrlXml": "/11909/11909_ms16800_1_14_010.xml", "classification": "Administrative", "publishedStatus": "FinalContent", "accessio