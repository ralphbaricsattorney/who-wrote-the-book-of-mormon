urchofjesuschrist.org/ch/jsp/images/icn-new-scribe-16.png\" alt=\"Indicates a change in handwriting to a different scribe.\"></a><div class=\"popup-content\"><div class=\"note-data editorial-footnote\" isnote=\"Y\"><p class=\"bottom_0\"><a href=\"/person/willard-richards\" class=\"referenceInPop\">Willard Richards</a> handwriting ends; handwriting presumably of subscriber begins.</p><hr></div></div></aside><aside class=\"popup-wrapper\" id=\"4693208821442629766\"><a href=\"#4693208821442629766\" class=\"reference staticPopup\" ro=\"x117562\" person=\"x117562\" title=\"Frederick Merryweather\">F Merryweathe [Frederick Merryweather]</a><div class=\"popup-content\"><div class=\"note-data\" isnote=\"Y\" isnonsearchable=\"Y\"><input type=\"hidden\" value=\"Merryweather, Frederick\"><p><a class=\"more\" href=\"/person/frederick-merryweather\">View Full Bio</a></p></div></div></aside>—</td> <td xml:id=\"X84043\">2-00 from store</td> </tr> </tbody></table> <div class=\"noindent wasptag\"> [p. 16]</div></body></html>", "calendarsOfDocuments": [], "versions": [], "images": {"smallImageUrl": "/13309/13309_ms1490_2_22_016_thumb.jpg", "mediumImageUrl": "/13309/13309_ms1490_2_22_016_med.jpg", "largeImageUrl": "/13309/13309_ms1490_2_22_016.jpg", "downloadImageUrl": "/13309/13309_ms1490_2_22_016_download.jpg"}, "imageCredit": "", "facsimile": "", "dzUrlXml": "/13309/13309_ms1490_2_22_016.xml", "classification": "Documents", "publishedStatus": "FinalContent", "accessionNumber": "13309", "requestedPageNumber": "16", "numberOfPages": "16", "editorialTitle": "Subscriptions for Willard Richards, 2 August 1843–12 March 1844", "cleanEditorialTitle": "Subscriptions for Willard Richards, 2 August 1843–12 March 1844", "date": "August 2, 1843", "handwriting": "Handwriting of Willard Richards, JS, and other subscribers", "footnotes": [{"id": "2876769079888010946", "text": "<html><head></head><body><p class=\"bottom_0\">Handwriting presumably of subscribers ends; <a href=\"/person/willard-richa