mage": "/430/430_ms4583_1_71_012_thumb.jpg", "page": "12", "label": "12", "href": "/paper-summary/letter-to-the-church-and-edward-partridge-20-march-1839/12"}, {"image": "/430/430_ms4583_1_71_013_thumb.jpg", "page": "13", "label": "13", "href": "/paper-summary/letter-to-the-church-and-edward-partridge-20-march-1839/13"}, {"image": "/430/430_ms4583_1_71_014_thumb.jpg", "page": "14", "label": "14", "href": "/paper-summary/letter-to-the-church-and-edward-partridge-20-march-1839/14"}, {"image": "/430/430_ms4583_1_71_015_thumb.jpg", "page": "15", "label": "15", "href": "/paper-summary/letter-to-the-church-and-edward-partridge-20-march-1839/15"}, {"image": "/430/430_ms4583_1_71_016_thumb.jpg", "page": "16", "label": "16", "href": "/paper-summary/letter-to-the-church-and-edward-partridge-20-march-1839/16"}, {"image": "/430/430_ms4583_1_71_017_thumb.jpg", "page": "17", "label": "17", "href": "/paper-summary/letter-to-the-church-and-edward-partridge-20-march-1839/17"}, {"image": "/430/430_ms4583_1_71_017-01_thumb.jpg", "page": "18", "label": "[18]", "href": "/paper-summary/letter-to-the-church-and-edward-partridge-20-march-1839/18"}], "tableOfContents": [], "summary": {"uri": "letter-to-the-church-and-edward-partridge-20-march-1839", "series": "JSPPD", "urlTitleValue": "JSPPD6", "documentSeriesTitle": "Letter to the Church and Edward Partridge, 20 March 1839", "editorialPageNumber": "7", "isPageNumberPresent": true, "searchUrl": "/published/jsp/searchable/papers/21225849/21225849-0007.xml", "clearText": "<html><head></head><body><div class=\"indent continuation wasptag\"> that was against us, so that if the supream Judge dose [does] not grant us our liberty he has got to act without cause contrary to honor evidence law or justice<aside class=\"popup-wrapper\" id=\"3376731704156672905\"><a href=\"#3376731704156672905\" class=\"editorial-note-static staticPopup\" title=\"Note\" name=\"trans34\"><span id=\"documenttrans34\">34</span></a><div class=\"popup-content\"><div class=\"note-data editorial-footnote\" isnote=\"Y\"><p class=\"bottom_0\">On 15 March 1839, the prisoners wrote petitions for writs of <a href=\"/topic/habeas-corpus\" class=\"referenceInPop\">habeas corpus</a>, with the intent to submit the petitions to the <a href=\"/place/missouri\" class=\"referenceInPop\">Missouri</a> Supreme Court. JS’s petition, which was cosigned by several <a href=\"/topic/church-of-christ\" class=\"referenceInPop\">Latter-day Saints</a> from <a href=\"/place/far-west-missouri\" class=\"referenceInPop\">Far West</a>, stated that the “petitioners aver that they can disprove evry item of testimony that has any tendency of criminality against the prisoner for they know it themselvs and can bring many others also to prove the same.” This statement suggests that the prisoners intended to introduce new witnesses to prove JS’s innocence. (<a href=\"/paper-summary/petition-to-george-o-tompkins-between-9-and-15-march-1839-state-of-missouri-v-gates-et-al-for-treason\" class=\"referenceInPop\" pop=\"/ajax/papers/tooltip/petition-to-george-o-tompkins-between-9-and-15-march-1839-state-of-missouri-v-gates-et-al-for-treason\" poptitle=\"Petition to George O. Tompkins, between 9 and 15 March\n\t\t\t\t\t\t1839 [State of Missouri v. Gates et al. for\n\t\t\t\t\t\tTreason]\">Petition to George Tompkins, between 9 and 15 Mar. 1839</a>.)</p><hr></div></div></aside> shearly to please the devil but we hope better things and trust that before many days God will so order our case that we shall be set at liberty and take up our habitation with the saints we received some letters last evening <a href=\"/paper-summary/letter-from-emma-smith-7-march-1839\" class=\"reference\" pop=\"/ajax/papers/tooltip/letter-from-emma-smith-7-march-1839\" poptitle=\"Letter from Emma Smith, 7 March 1839\">one</a> from <aside class=\"popup-wrapper\" id=\"9353466643032697203\"><a href=\"#9353466643032697203\" class=\"reference staticPopup\" ro=\"per86\" person=\"per86\" title=\"Emma Hale Smith\">Emma</a><div class=\"popup-content\"><div class=\"note-data\" isnote=\"Y\" isnonsearchable=\"Y\"><input type=\"hidden\" value=\"Smith, Emma Hale\"><p>10 July 1804–30 Apr. 1879. Scribe, editor, boardinghouse operator, clothier. Born at Willingborough Township (later in Harmony), Susquehanna Co., Pennsylvania. Daughter of Isaac Hale and Elizabeth Lewis. Member of Methodist church at Harmony (later in Oakland...</p><a class=\"more\" href=\"/person/emma-hale-smith\">View Full Bio</a></div></div></aside><aside class=\"popup-wrapper\" id=\"6736200896243505592\"><a href=\"#6736200896243505592\" class=\"editorial-note-static staticPopup\" title=\"Note\" name=\"trans35\"><span id=\"documenttrans35\">35</span></a><div class=\"popup-content\"><div class=\"note-data editorial-footnote\" isnote=\"Y\"><p class=\"bottom_0\"><a href=\"/paper-summary/letter-from-emma-smith-7-march-1839\" class=\"referenceInPop\" pop=\"/ajax/papers/tooltip/letter-from-emma-smith-7-march-1839\" poptitle=\"Letter from Emma Smith, 7 March 1839\">Letter from Emma Smith, 7 Mar. 1839</a>.</p><hr></div></div></aside> <a href=\"/paper-summary/letter-from-don-carlos-smith-and-william-smith-6-march-1839\" class=\"reference\" pop=\"/ajax/papers/tooltip/letter-from-don-carlos-smith-and-william-smith-6-march-1839\" poptitle=\"Letter from Don Carlos Smith and William Smith, 6 March 1839\">one</a> from <aside class=\"popup-wrapper\" id=\"9670403119101040158\"><a href=\"#9670403119101040158\" class=\"reference staticPopup\" ro=\"per493\" person=\"per493\" title=\"Don Carlos Smith (JS’s brother)\">Don Carlos Smith</a><div class=\"popup-content\"><div class=\"note-data\" isnote=\"Y\" isnonsearchable=\"Y\"><input type=\"hidden\" value=\"Smith, Don Carlos (JS’s brother)\"><p>25 Mar. 1816–7 Aug. 1841. Farmer, printer, editor. Born at Norwich, Windsor Co., Vermont. Son of Joseph Smith Sr. and Lucy Mack. Moved to Palmyra, Ontario Co., New York, 1816–Jan. 1817. Moved to Manchester, Ontario Co., 1825. Baptized into Church of Jesus...</p><a class=\"more\" href=\"/person/don-carlos-smith-jss-brother\">View Full Bio</a></div></div></aside><aside class=\"popup-wrapper\" id=\"13419683393164032514\"><a href=\"#13419683393164032514\" class=\"editorial-note-static staticPopup\" title=\"Note\" name=\"trans36\"><span id=\"documenttrans36\">36</span></a><div class=\"popup-content\"><div class=\"note-data editorial-footnote\" isnote=\"Y\"><p class=\"bottom_0\"><a href=\"/paper-summary/letter-from-don-carlos-smith-and-william-smith-6-march-1839\" class=\"referenceInPop\" pop=\"/ajax/papers/tooltip/letter-from-don-carlos-smith-and-william-smith-6-march-1839\" poptitle=\"Letter from Don Carlos Smith and William Smith, 6 March 1839\">Letter from Don Carlos Smith and William Smith, 6 Mar. 1839</a>.</p><hr></div></div></aside> and <a href=\"/paper-summary/letter-from-edward-partridge-5-march-1839\" class=\"reference\" pop=\"/ajax/papers/tooltip/letter-from-edward-partridge-5-march-1839\" poptitle=\"Letter from Edward Partridge, 5 March 1839\">one</a> from <aside class=\"popup-wrapper\" id=\"3564881694026377921\"><a href=\"#3564881694026377921\" class=\"reference staticPopup\" ro=\"per77\" person=\"per77\" title=\"Edward Partridge\">Bishop Partridge</a><div class=\"popup-content\"><div class=\"note-data\" isnote=\"Y\" isnonsearchable=\"Y\"><input type=\"hidden\" value=\"Partridge, Edward\"><p>27 Aug. 1793–27 May 1840. Hatter. Born at Pittsfield, Berkshire Co., Massachusetts. Son of William Partridge and Jemima Bidwell. Moved to Painesville, Geauga Co., Ohio. Married Lydia Clisbee, 22 Aug. 1819, at Painesville. Initially a Universal Restorationist...</p><a class=\"more\" href=\"/person/edward-partridge\">View Full Bio</a></div></div></aside><aside class=\"popup-wrapper\" id=\"11002612578013336087\"><a href=\"#11002612578013336087\" class=\"editorial-note-static staticPopup\" title=\"Note\" name=\"trans37\"><span id=\"documenttrans37\">37</span></a><div class=\"popup-content\"><div class=\"note-data editorial-footnote\" isnote=\"Y\"><p class=\"bottom_0\"><a href=\"/paper-summary/letter-from-edward-partridge-5-march-1839\" class=\"referenceInPop\" pop=\"/ajax/papers/tooltip/letter-from-edward-partridge-5-march-1839\" poptitle=\"Letter from Edward Partridge, 5 March 1839\">Letter from Edward Partridge, 5 Mar. 1839</a>.</p><hr></div></div></aside> all breathing a kind and consoling spirit we were much gratified with there contence [contents] we had been a long time without information and when we read those letters they were to our <span class=\"josephswriting\">souls</span><aside class=\"popup-wrapper\" id=\"8746691348961860081\"><a href=\"#8746691348961860081\" class=\"new-scribe-note staticPopup\" title=\"New Scribe\" name=\"trans4\"><img src=\"//cdn.churchofjesuschrist.org/ch/jsp/images/icn-new-scribe-16.png\" alt=\"Indicates a change in handwriting to a different scribe.\"></a><div class=\"popup-content\"><div class=\"note-data editorial-footnote\" isnote=\"Y\"><p class=\"bottom_0\">Correction in the handwriting of JS.</p><hr></div></div></aside><span class=\"josephswriting\"> </span>as the gentle air, is refreshing but our joy was mingled with greaf because of the suffering of the poor and much injured saints and we need not say to you that the flood gates of our harts were hoisted and our eyes were a fountain of tears but those who have not been inclosed in the walls of a prison without cause or provication can have but a little ideah how sweat sweet the voice of a friend is one token of friendship from any sorce whatever awakens and calles into action evry simpathetick feeling it brings up in an instant evry thing that is passed it sesses [seizes] the presant with a vivasity of lightning it grasps after the future with the fearsness fierceness of a tiger it rhetrogrades from one thing to an other untill finally all enmity malice and hatred and past diferances misunderstandings and mis [p. 7]</div></body></html>", "expandedText": "<html><head></head><body><div class=\"indent continuation wasptag\"> that was against us, so that if the supream Judge <span class=\"line-break\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>dose [does] &lt;​not grant​&gt; us our liberty he has got to act without cause <span class=\"line-break\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>contrary to honor evidence law or justice<aside class=\"popup-wrapper\" id=\"10368509153120067483\"><a href=\"#10368509153120067483\" class=\"editorial-note-static staticPopup\" title=\"Note\" name=\"trans34\"><span id=\"documenttrans34\">34</span></a><div class=\"popup-content\"><div class=\"note-data editorial-footnote\" isnote=\"Y\"><p class=\"bottom_0\">On 15 March 1839, the prisoners wrote petitions for writs of <a href=\"/topic/habeas-corpus\" class=\"referenceInPop\">habeas corpus</a>, with the intent to submit the petitions to the <a href=\"/place/missouri\" class=\"referenceInPop\">Missouri</a> Supreme Court. JS’s petition, which was cosigned by several <a href=\"/topic/church-of-christ\" class=\"referenceInPop\">Latter-day Saints</a> from <a href=\"/place/far-west-missouri\" class=\"referenceInPop\">Far West</a>, stated that the “petitioners aver that they can disprove evry item of testimony that has any tendency of criminality against the prisoner for they know it themselvs and can bring many others also to prove the same.” This statement suggests that the prisoners intended to introduce new witnesses to prove JS’s innocence. (<a href=\"/paper-summary/petition-to-george-o-tompkins-between-9-and-15-march-1839-state-of-missouri-v-gates-et-al-for-treason\" class=\"referenceInPop\" pop=\"/ajax/papers/tooltip/petition-to-george-o-tompkins-between-9-and-15-march-1839-state-of-missouri-v-gates-et-al-for-treason\" poptitle=\"Petition to George O. Tompkins, between 9 and 15 March\n\t\t\t\t\t\t1839 [State of Missouri v. Gates et al. for\n\t\t\t\t\t\tTreason]\">Petition to George Tompkins, between 9 and 15 Mar. 1839</a>.)</p><hr></div></div></aside> shearly <span class=\"line-break\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>to please the devil but we hope better things and tru<span class=\"line-break hyphenate\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>st that before many days God will so order our case <span class=\"line-break\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>that we shall be set at liberty and take up our habita<span class=\"line-break hyphenate\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>tion with the saints we received some letters last eve<span class=\"line-break hyphenate\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>ning <a href=\"/paper-summary/letter-from-emma-smith-7-march-1839\" class=\"reference\" pop=\"/ajax/papers/tooltip/letter-from-emma-smith-7-march-1839\" poptitle=\"Letter from Emma Smith, 7 March 1839\">one</a> from <aside class=\"popup-wrapper\" id=\"13547025749902711749\"><a href=\"#13547025749902711749\" class=\"reference staticPopup\" ro=\"per86\" person=\"per86\" title=\"Emma Hale Smith\">Emma</a><div class=\"popup-content\"><div class=\"note-data\" isnote=\"Y\" isnonsearchable=\"Y\"><input type=\"hidden\" value=\"Smith, Emma Hale\"><p>10 July 1804–30 Apr. 1879. Scribe, editor, boardinghouse operator, clothier. Born at Willingborough Township (later in Harmony), Susquehanna Co., Pennsylvania. Daughter of Isaac Hale and Elizabeth Lewis. Member of Methodist church at Harmony (later in Oakland...</p><a class=\"more\" href=\"/person/emma-hale-smith\">View Full Bio</a></div></div></aside><aside class=\"popup-wrapper\" id=\"15127583113431085918\"><a href=\"#15127583113431085918\" class=\"editorial-note-static staticPopup\" title=\"Note\" name=\"trans35\"><span id=\"documenttrans35\">35</span></a><div class=\"popup-content\"><div class=\"note-data editorial-footnote\" isnote=\"Y\"><p class=\"bottom_0\"><a href=\"/paper-summary/letter-from-emma-smith-7-march-1839\" class=\"referenceInPop\" pop=\"/ajax/papers/tooltip/letter-from-emma-smith-7-march-1839\" poptitle=\"Letter from Emma Smith, 7 March 1839\">Letter from Emma Smith, 7 Mar. 1839</a>.</p><hr></div></div></aside> <a href=\"/paper-summary/letter-from-don-carlos-smith-and-william-smith-6-march-1839\" class=\"reference\" pop=\"/ajax/papers/tooltip/letter-from-don-carlos-smith-and-william-smith-6-march-1839\" poptitle=\"Letter from Don Carlos Smith and William Smith, 6 March 1839\">one</a> from <aside class=\"popup-wrapper\" id=\"11759822212432937064\"><a href=\"#11759822212432937064\" class=\"reference staticPopup\" ro=\"per493\" person=\"per493\" title=\"Don Carlos Smith (JS’s brother)\">Don C[arlos] Smith</a><div class=\"popup-content\"><div class=\"note-data\" isnote=\"Y\" isnonsearchable=\"Y\"><input type=\"hidden\" value=\"Smith, Don Carlos (JS’s brother)\"><p>25 Mar. 1816–7 Aug. 1841. Farmer, printer, editor. Born at Norwich, Windsor Co., Vermont. Son of Joseph Smith Sr. and Lucy Mack. Moved to Palmyra, Ontario Co., New York, 1816–Jan. 1817. Moved to Manchester, Ontario Co., 1825. Baptized into Church of Jesus...</p><a class=\"more\" href=\"/person/don-carlos-smith-jss-brother\">View Full Bio</a></div></div></aside><aside class=\"popup-wrapper\" id=\"10933734684975965782\"><a href=\"#10933734684975965782\" class=\"editorial-note-static staticPopup\" title=\"Note\" name=\"trans36\"><span id=\"documenttrans36\">36</span></a><div class=\"popup-content\"><div class=\"note-data editorial-footnote\" isnote=\"Y\"><p class=\"bottom_0\"><a href=\"/paper-summary/letter-from-don-carlos-smith-and-william-smith-6-march-1839\" class=\"referenceInPop\" pop=\"/ajax/papers/tooltip/letter-from-don-carlos-smith-and-william-smith-6-march-1839\" poptitle=\"Letter from Don Carlos Smith and William Smith, 6 March 1839\">Letter from Don Carlos Smith and William Smith, 6 Mar. 1839</a>.</p><hr></div></div></aside> and <a href=\"/paper-summary/letter-from-edward-partridge-5-march-1839\" class=\"reference\" pop=\"/ajax/papers/tooltip/letter-from-edward-partridge-5-march-1839\" poptitle=\"Letter from Edward Partridge, 5 March 1839\"><span class=\"line-break\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>one</a> from <aside class=\"popup-wrapper\" id=\"16245421388656464693\"><a href=\"#16245421388656464693\" class=\"reference staticPopup\" ro=\"per77\" person=\"per77\" title=\"Edward Partridge\">Bishop Partridge</a><div class=\"popup-content\"><div class=\"note-data\" isnote=\"Y\" isnonsearchable=\"Y\"><input type=\"hidden\" value=\"Partridge, Edward\"><p>27 Aug. 1793–27 May 1840. Hatter. Born at Pittsfield, Berkshire Co., Massachusetts. Son of William Partridge and Jemima Bidwell. Moved to Painesville, Geauga Co., Ohio. Married Lydia Clisbee, 22 Aug. 1819, at Painesville. Initially a Universal Restorationist...</p><a class=\"more\" href=\"/person/edward-partridge\">View Full Bio</a></div></div></aside><aside class=\"popup-wrapper\" id=\"2100490937801970342\"><a href=\"#2100490937801970342\" class=\"editorial-note-static staticPopup\" title=\"Note\" name=\"trans37\"><span id=\"documenttrans37\">37</span></a><div class=\"popup-content\"><div class=\"note-data editorial-footnote\" isnote=\"Y\"><p class=\"bottom_0\"><a href=\"/paper-summary/letter-from-edward-partridge-5-march-1839\" class=\"referenceInPop\" pop=\"/ajax/papers/tooltip/letter-from-edward-partridge-5-march-1839\" poptitle=\"Letter from Edward Partridge, 5 March 1839\">Letter from Edward Partridge, 5 Mar. 1839</a>.</p><hr></div></div></aside> all breathing a kind <span class=\"line-break\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>and consoling spirit we were much gratified with <span class=\"line-break\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>there contence [contents] we had been a long time without <span class=\"line-break\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>information and when we read those letters they <span class=\"line-break\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>were to our <span class=\"deleted\">soles</span> &lt;​<span class=\"josephswriting\">souls</span>​&gt;<aside class=\"popup-wrapper\" id=\"8888551101816901909\"><a href=\"#8888551101816901909\" class=\"new-scribe-note staticPopup\" title=\"New Scribe\" name=\"trans4\"><img src=\"//cdn.churchofjesuschrist.org/ch/jsp/images/icn-new-scribe-16.png\" alt=\"Indicates a change in handwriting to a different scribe.\"></a><div class=\"popup-content\"><div class=\"note-data editorial-footnote\" isnote=\"Y\"><p class=\"bottom_0\">Correction in the handwriting of JS.</p><hr></div></div></aside><span class=\"josephswriting\"> </span>as the gentle air, &lt;​is​&gt; refreshing <span class=\"line-break\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>but our joy was mingled with greaf because of the <span class=\"line-break\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>suffering of the poor and much injured saints and <span class=\"line-break\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>we need not say to you that the flood gates of our <span class=\"line-break\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>harts were hoisted and our eyes were a fountain <span class=\"line-break\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>of tears but those who have not been inclosed in the <span class=\"line-break\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>walls of a prison without cause or provication can <span class=\"line-break\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>have but a little ideah how sweat [sweet] the voice of a <span class=\"line-break\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>friend is one token of friendship from any <span class=\"line-break\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>sorce whatever awakens and calles into action evry <span class=\"line-break\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>simpathetick feeling it brings up in an instant evry <span class=\"line-break\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>thing that is pas[s]ed it sesses [seizes?] the presant with a vivasity <span class=\"line-break\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>of lightning it grasps after the future with the fearsn<span class=\"line-break hyphenate\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>ess [fierceness] of a tiger it rhetrogrades from one thing to an<span class=\"line-break hyphenate\" xmlns=\"http://www.w3.org/1999/xhtml\"></span> other untill finally all enmity malice and hatred and <span class=\"line-break\" xmlns=\"http://www.w3.org/1999/xhtml\"></span>past diferances misunderstandings and mis [p. 7]</div></body></html>", "calendarsOfDocuments": [], "versions": [{"versionTitle": "Letter to the Church and Edward Partridge, 20 March 1839", "versionLink": "/paper-summary/letter-to-the-church-and-edward-partridge-20-march-1839/1", "versionFeatured": "true"}, {"versionTitle": "Letter to the Church and Edward Partridge, 20 March 1839, as Published in <em xmlns:tei=\"http://www.tei-c.org/ns/1.0\" xmlns:lds=\"https://ldsc.xmlref.com/local/ldschurch\">Times and Seasons</em>", "versionLink": "/paper-summary/letter-to-the-church-and-edward-partridge-20-march-1839-as-published-in-times-and-seasons/1", "versionFeatured": ""}, {"versionTitle": " History, 1838–1856, volume C-1 [2 November 1838–31 July 1842]", "versionLink": "/paper-summary/history-1838-1856-volume-c-1-2-november-1838-31-july-1842/81", "versionFeatured": ""}, {"versionTitle": "“History of Joseph Smith”", "versionLink": "/paper-summary/history-of-joseph-smith/333", "versionFeatured": ""}], "images": {"smallImageUrl": "/430/430_ms4583_1_71_007_thumb.jpg", "mediumImageUrl": "/430/430_ms4583_1_71_007_med.jpg", "largeImageUrl": "/430/430_ms4583_1_71_007.jpg", "downloadImageUrl": "/430/430_ms4583_1_71_007_download.jpg"}, "imageCredit": "", "facsimile": "", "dzUrlXml": "/430/430_ms4583_1_71_007.xml", "classification": "Documents", "publishedStatus": "FinalContent", "accessionNumber": "430", "requestedPageNumber": "7", "numberOfPages": "18", "editorialTitle": "Letter to the Church and Edward Partridge, 20 March 1839", "cleanEditorialTitle": "Letter to the Church and Edward Partridge, 20 March 1839", "date": "March 20, 1839", "handwriting": "Handwriting of Alexander McRae and Caleb Baldwin, with insertions by JS", "footnotes": [{"id": "10368509153120067483", "text": "<html><head></head><body><p class=\"bottom_0\">On 15 March 1839, the prisoners wrote petitions for writs of <a href=\"/topic/habeas-corpus\" class=\"referenceInPop\">habeas corpus</a>, with the intent to submit the petitions to the <a href=\"/place/missouri\" class=\"referenceInPop\">Missouri</a> Supreme Court. JS’s petition, which was cosigned by several <a href=\"/topic/church-of-christ\" class=\"referenceInPop\">Latter-day Saints</a> from <a href=\"/place/far-west-missouri\" class=\"referenceInPop\">Far West</a>, stated that the “petitioners aver that they can disprove evry item of testimony that has any tendency of criminality against the prisoner for they know it themselvs and can bring many others also to prove the same.” This statement suggests that the prisoners intended to introduce new witnesses to prove JS’s innocence. (<a href=\"/paper-summary/petition-to-george-o-tompkins-between-9-and-15-march-1839-state-of-missouri-v-gates-et-al-for-treason\" class=\"referenceInPop\" pop=\"/ajax/papers/tooltip/petition-to-george-o-tompkins-between-9-and-15-march-1839-state-of-missouri-v-gates-et-al-for-treason\" poptitle=\"Petition to George O. Tompkins, between 9 and 15 March\n\t\t\t\t\t\t1839 [State of Missouri v. Gates et al. for\n\t\t\t\t\t\tTreason]\">Petition to George Tompkins, between 9 and 15 Mar. 1839</a>.)</p></body></html>", "number": 34, "type": "number", "toenote": "", "longcitation": null}, {"id": "15127583113431085918", "text": "<html><head></head><body><p class=\"bottom_0\"><a href=\"/paper-summary/letter-from-emma-smith-7-march-1839\" class=\"referenceInPop\" pop=\"/ajax/papers/tooltip/letter-from-emma-smith-7-march-1839\" poptitle=\"Letter from Emma Smith, 7 March 1839\">Letter from Emma Smith, 7 Mar. 1839</a>.</p></body></html>", "number": 35, "type": "number", "toenote": "", "longcitation": null}, {"id": "10933734684975965782", "text": "<html><head></head><body><p class=\"bottom_0\"><a href=\"/paper-summary/letter-from-don-carlos-smith-and-william-smith-6-march-1839\" class=\"referenceInPop\" pop=\"/ajax/papers/tooltip/letter-from-don-carlos-smith-and-william-smith-6-march-1839\" poptitle=\"Letter from Don Carlos Smith and William Smith, 6 March 1839\">Letter from Don Carlos Smith and William Smith, 6 Mar. 1839</a>.</p></body></html>", "number": 36, "type": "number", "toenote": "", "longcitation": null}, {"id": "2100490937801970342", "text": "<html><head></head><body><p class=\"bottom_0\"><a href=\"/paper-summary/letter-from-edward-partridge-5-march-1839\" class=\"referenceInPop\" pop=\"/ajax/papers/tooltip/letter-from-edward-partridge-5-march-1839\" poptitle=\"Letter from Edward Partridge, 5 March 1839\">Letter from Edward Partridge, 5 Mar. 1839</a>.</p></body></html>", "number": 37, "type": "number", "toenote": "", "longcitation": null}, {"id": "8888551101816901909", "text": "<html><head></head><body><p class=\"bottom_0\">Correction in the handwriting of JS.</p></body></html>", "number": null, "type": "scribal", "toenote": "", "longcitation": null}], "meta": {"/paper-summary-PageTitle": "Letter to the Church and Edward Partridge, 20 March 1839, Page 7", "/paper-summary-MetaTitle": "Letter to the Church and Edward Partridge, 20 March 1839, Page 7", "/paper-summary-MetaDescription": "that was against us, so that if the supream Judge dose [does] not grant us our liberty he has got to...", "/paper-summary-MetaUrl": "/paper-summary/letter-to-the-church-and-edward-partridge-20-march-1839/7", "/paper-summary-MetaImage": "/bc-jsp/content/jsp/images/430/430_ms4583_1_71_007_thumb.jpg"}, "scribes": [{"id": "per1113", "name": "Alexander McRae"}, {"id": "per46", "name": "Joseph Smith Jr."}], "printVolumeLocation": "<a href=\"http://www.josephsmithpapers.org/articles/documents-volume-6-february-183