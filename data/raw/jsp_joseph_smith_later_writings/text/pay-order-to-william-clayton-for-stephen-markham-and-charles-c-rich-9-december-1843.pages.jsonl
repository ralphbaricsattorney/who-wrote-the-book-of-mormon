{"page": "1", "label": "[1]", "page_scribes": ["Joseph Smith Jr.", "Wilson Law"], "segments": [{"scribe": "Joseph Smith Jr.", "js_hand": true, "text": "Nauvoo City De"}, {"scribe": "Joseph Smith Jr.", "js_hand": false, "text": "["}, {"scribe": "Joseph Smith Jr.", "js_hand": true, "text": "r"}, {"scribe": "Joseph Smith Jr.", "js_hand": false, "text": "]"}, {"scribe": "Joseph Smith Jr.", "js_hand": true, "text": ". 9th 1843"}, {"scribe": "Joseph Smith Jr.", "js_hand": true, "text": "Mr. William Clayton Treasury for the City of Nauvoo you will Please pay out of the City funds in your hands Sixty dollers to be paid to the Commandants of Cohorts to be used in case of defence"}, {"scribe": "Joseph Smith Jr.", "js_hand": true, "text": "Joseph Smith"}, {"scribe": "Joseph Smith Jr.", "js_hand": true, "text": "Mayor of said City"}, {"scribe": "Joseph Smith Jr.", "js_hand": false, "text": "\n[]\n"}, {"scribe": "Wilson Law", "js_hand": false, "text": "The commandant of the 1st. and 2nd. cohorts is, of the 1st. Col. Stephen Markham in the absence of his Senr. Officers, and Genl. Charles C. Rich of the 2nd..\nWilson Law\nMajor. Gel. [p. [1]]\n"}]}
{"page": "2", "label": "[2]", "page_scribes": ["William Clayton"], "segments": [{"scribe": "William Clayton", "js_hand": false, "text": "\nNauvoo Legion\nEntered Decr 9— 43> [p. [2]]\n"}]}
