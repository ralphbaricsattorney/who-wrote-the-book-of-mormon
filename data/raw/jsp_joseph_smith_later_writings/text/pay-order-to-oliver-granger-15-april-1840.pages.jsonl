{"page": "1", "label": "[1]", "page_scribes": ["Joseph Smith Jr."], "segments": [{"scribe": "Joseph Smith Jr.", "js_hand": true, "text": "Nauvoo April 15th 1840"}, {"scribe": "Joseph Smith Jr.", "js_hand": true, "text": "Elder Oliver Granger"}, {"scribe": "Joseph Smith Jr.", "js_hand": true, "text": "Dear sir"}, {"scribe": "Joseph Smith Jr.", "js_hand": true, "text": "Please let the bearer have twelve dollers out of your Store and Charge the same to me and Obliege your friend &C—"}, {"scribe": "Joseph Smith Jr.", "js_hand": true, "text": "Joseph Smith Jr— "}, {"scribe": "Joseph Smith Jr.", "js_hand": false, "text": " [p. [1]]\n"}]}
