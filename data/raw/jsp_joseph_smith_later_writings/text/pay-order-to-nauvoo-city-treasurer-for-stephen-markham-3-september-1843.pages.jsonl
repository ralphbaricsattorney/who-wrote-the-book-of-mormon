{"page": "1", "label": "[1]", "page_scribes": ["Henry G. Sherwood", "Joseph Smith Jr."], "segments": [{"scribe": "Henry G. Sherwood", "js_hand": false, "text": "I hereby certify that Stephen Markham assisted in moving Mr Dayly in Case of Small pox— thought to be worth $1—.\n3 Sept 1843— Charged to the city of Nauvoo—\nHenry G Sherwood Constable\n"}, {"scribe": "Joseph Smith Jr.", "js_hand": true, "text": "Treasurer will please to pay"}, {"scribe": "Joseph Smith Jr.", "js_hand": true, "text": "Joseph Smith"}, {"scribe": "Joseph Smith Jr.", "js_hand": true, "text": "Mayor "}, {"scribe": "Joseph Smith Jr.", "js_hand": false, "text": " [p. [1]]\n"}]}
{"page": "2", "label": "[0]", "page_scribes": ["William Clayton"], "segments": [{"scribe": "William Clayton", "js_hand": false, "text": "\nS. Markham\nDecr. 13— 1843\npaid>\n"}]}
