{"page": "1", "label": "[1]", "page_scribes": ["Joseph Smith Jr."], "segments": [{"scribe": "Joseph Smith Jr.", "js_hand": true, "text": "December 1st 1838"}, {"scribe": "Joseph Smith Jr.", "js_hand": true, "text": "My Dear companion I take this oppertunity to inform you that we arrived in Liberty and commited to Joal "}, {"scribe": "Joseph Smith Jr.", "js_hand": false, "text": "["}, {"scribe": "Joseph Smith Jr.", "js_hand": true, "text": "jail"}, {"scribe": "Joseph Smith Jr.", "js_hand": false, "text": "]"}, {"scribe": "Joseph Smith Jr.", "js_hand": true, "text": " this Evening but we are all in good spirits Captain bogard "}, {"scribe": "Joseph Smith Jr.", "js_hand": false, "text": "["}, {"scribe": "Joseph Smith Jr.", "js_hand": true, "text": "Samuel Bogart"}, {"scribe": "Joseph Smith Jr.", "js_hand": false, "text": "]"}, {"scribe": "Joseph Smith Jr.", "js_hand": true, "text": " will hand you this line my respects to all remain where you are at preasant"}, {"scribe": "Joseph Smith Jr.", "js_hand": true, "text": "yours &c—"}, {"scribe": "Joseph Smith Jr.", "js_hand": true, "text": "Joseph Smith Jr "}, {"scribe": "Joseph Smith Jr.", "js_hand": false, "text": " [p. [1]]\n"}]}
