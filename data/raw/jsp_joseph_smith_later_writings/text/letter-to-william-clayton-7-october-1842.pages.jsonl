{"page": "1", "label": "[1]", "page_scribes": ["Joseph Smith Jr."], "segments": [{"scribe": "Joseph Smith Jr.", "js_hand": true, "text": "Oct— 7th 1842 in Solitude for love of Truth"}, {"scribe": "Joseph Smith Jr.", "js_hand": true, "text": "Brother William Clayton"}, {"scribe": "Joseph Smith Jr.", "js_hand": true, "text": "Dear Sir"}, {"scribe": "Joseph Smith Jr.", "js_hand": true, "text": "I recieved your short note I reply in short be shure you are right and then go ahead David Crocket like and now Johnathan what shall I write more only that I am well and am your best Friend"}, {"scribe": "Joseph Smith Jr.", "js_hand": true, "text": "Joseph Smith"}, {"scribe": "Joseph Smith Jr.", "js_hand": true, "text": "or David"}, {"scribe": "Joseph Smith Jr.", "js_hand": true, "text": "or his mark"}, {"scribe": "Joseph Smith Jr.", "js_hand": true, "text": "——X——"}, {"scribe": "Joseph Smith Jr.", "js_hand": true, "text": "to William Clayton) "}, {"scribe": "Joseph Smith Jr.", "js_hand": false, "text": "[]"}, {"scribe": "Joseph Smith Jr.", "js_hand": false, "text": " [p. [1]]\n"}]}
{"page": "2", "label": "[2]", "page_scribes": [], "segments": [{"scribe": "Joseph Smith Jr.", "js_hand": false, "text": "\n[]"}, {"scribe": "Joseph Smith Jr.", "js_hand": false, "text": " [p. [2]]\n"}]}
