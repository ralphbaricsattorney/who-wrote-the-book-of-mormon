{"page": "1", "label": "[1]", "page_scribes": ["Joseph Smith Jr."], "segments": [{"scribe": "Joseph Smith Jr.", "js_hand": true, "text": "Nauvoo Dec. 12th 1840"}, {"scribe": "Joseph Smith Jr.", "js_hand": true, "text": "Brother Whitney"}, {"scribe": "Joseph Smith Jr.", "js_hand": true, "text": "Dear Sir"}, {"scribe": "Joseph Smith Jr.", "js_hand": true, "text": "I am at work in my office am under the necesity to have some help from time to time to help me along in my calling I therefore desire you to let the bearer of this have some of that dry wood to burn in the stove of my office and obliege"}, {"scribe": "Joseph Smith Jr.", "js_hand": true, "text": "your humble servent"}, {"scribe": "Joseph Smith Jr.", "js_hand": true, "text": "Joseph Smith "}, {"scribe": "Joseph Smith Jr.", "js_hand": false, "text": " [p. [1]]\n"}]}
{"page": "2", "label": "[2]", "page_scribes": [], "segments": [{"scribe": "Joseph Smith Jr.", "js_hand": false, "text": "\n[]"}, {"scribe": "Joseph Smith Jr.", "js_hand": false, "text": " [p. [2]]\n"}]}
